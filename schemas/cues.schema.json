{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klights/schemas/cues.schema.json",
  "title": "cosmos cues",
  "description": "The night as an ordered list of cues, each filling the same three slots a preset does plus a fade and an optional hold, in beats.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "movement": {
            "type": "object"
          },
          "color": {
            "type": "object"
          },
          "level": {
            "type": "object"
          },
          "fade": {
            "type": "number",
            "minimum": 0,
            "description": "beats to crossfade in, not seconds"
          },
          "hold": {
            "type": "number",
            "minimum": 0,
            "description": "beats before advancing on its own. 0 waits for GO"
          },
          "speed": {
            "type": "number",
            "minimum": 0
          },
          "master": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "macro": {
            "type": "object"
          },
          "rates": {
            "type": "object",
            "description": "per-slot chase rates, e.g. {\"color\": 0.5, \"movement\": 2}"
          },
          "params": {
            "type": "object",
            "description": "per-routine parameter values, by look name, e.g. {\"Ball Orbit\": {\"radius_deg\": 24}}"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "version": {
      "type": "integer",
      "description": "Format version. Current is 1; a file with no version is treated as 1."
    }
  },
  "required": [
    "cues"
  ],
  "additionalProperties": true
}
