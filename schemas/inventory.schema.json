{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klights/schemas/inventory.schema.json",
  "title": "cosmos inventory",
  "description": "Hardware actually owned. Events select from this; they never redefine hardware.",
  "type": "object",
  "properties": {
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "qxf": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "owned",
              "unverified",
              "retired"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "manufacturer",
          "model",
          "count"
        ]
      }
    },
    "version": {
      "type": "integer",
      "description": "Format version. Current is 1; a file with no version is treated as 1."
    }
  },
  "required": [
    "fixtures"
  ],
  "additionalProperties": true
}
