{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klights/schemas/looks.schema.json",
  "title": "cosmos looks",
  "description": "The look library, normally generated by shared/tools/port_library.py.",
  "type": "object",
  "properties": {
    "reference_bpm": {
      "type": "number",
      "minimum": 1
    },
    "source": {
      "type": "string"
    },
    "looks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "pose",
              "path",
              "mixed",
              "color",
              "color_path",
              "intensity",
              "level_path"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bars": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "kind"
        ]
      }
    },
    "version": {
      "type": "integer",
      "description": "Format version. Current is 1; a file with no version is treated as 1."
    }
  },
  "required": [
    "looks"
  ],
  "additionalProperties": true
}
