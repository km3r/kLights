{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cosmos-lights/schemas/rig.schema.json",
  "title": "cosmos rig",
  "description": "What is plugged in: fixtures, addresses, positions, tags, and which room this event uses.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "description": "the name of a file in shared/venues/, without the .json -- or omit it to use this event's own venue.json"
    },
    "mount_mode": {
      "type": "string",
      "enum": [
        "table",
        "venue",
        "hung"
      ],
      "description": "how the heads are physically mounted. 'venue' is the sideways corner install where Pan carries elevation"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "description": "must match a <Mode Name=...> in the fixture's .qxf"
          },
          "universe": {
            "type": "integer",
            "minimum": 0
          },
          "address": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512,
            "description": "the DMX start channel, 1-512"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beam_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 180,
            "description": "beam cone angle. Safety-relevant: too small and the taper under-protects. See docs/SAFETY.md"
          },
          "lumens": {
            "type": "number",
            "minimum": 0
          },
          "pan_range_deg": {
            "type": "number",
            "minimum": 0
          },
          "tilt_range_deg": {
            "type": "number",
            "minimum": 0
          },
          "pan_speed_deg_s": {
            "type": "number",
            "minimum": 0
          },
          "tilt_speed_deg_s": {
            "type": "number",
            "minimum": 0
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "hold": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "manufacturer",
          "model",
          "mode",
          "address"
        ]
      }
    },
    "version": {
      "type": "integer",
      "description": "Format version. Current is 1; a file with no version is treated as 1."
    }
  },
  "required": [
    "fixtures"
  ],
  "additionalProperties": true
}
