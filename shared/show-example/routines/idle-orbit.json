{
  "$schema": "../../../schemas/routine.schema.json",
  "kind": "klights.routine",
  "version": 1,
  "id": "idle-orbit",
  "name": "Idle orbit",
  "bars": 8,
  "loop": true,
  "roles": {
    "movers": {
      "default": "movers"
    },
    "pins": {
      "default": "pinspots",
      "optional": true
    }
  },
  "params": {
    "color": {
      "type": "color",
      "default": "@primary"
    },
    "radius": {
      "type": "number",
      "default": 10,
      "min": 0,
      "max": 45,
      "unit": "deg"
    }
  },
  "rows": [
    {
      "id": "m",
      "type": "clips",
      "target": "movement",
      "role": "movers",
      "items": [
        {
          "id": "orbit",
          "at": 0,
          "len": 32,
          "block": "orbit",
          "args": {
            "radius": "$radius",
            "bars": 8
          }
        }
      ]
    },
    {
      "id": "c",
      "type": "clips",
      "target": "color",
      "role": "movers",
      "items": [
        {
          "id": "solid",
          "at": 0,
          "len": 32,
          "block": "solid",
          "args": {
            "color": "$color"
          }
        }
      ]
    },
    {
      "id": "l",
      "type": "clips",
      "target": "level",
      "role": "pins",
      "items": [
        {
          "id": "dim",
          "at": 0,
          "len": 32,
          "block": "dim",
          "args": {
            "level": 0.6
          }
        }
      ]
    }
  ]
}
