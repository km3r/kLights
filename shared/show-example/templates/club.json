{
  "$schema": "../../../schemas/template_set.schema.json",
  "kind": "klights.template_set",
  "version": 1,
  "id": "club",
  "name": "Club",
  "palettes": {
    "Cool": {
      "primary": "#3b82f6",
      "secondary": "#14b8a6",
      "accent": "#e2e8f0"
    },
    "Hot": {
      "primary": "#ff2d6f",
      "secondary": "#ff8a00",
      "accent": "#ffffff"
    }
  },
  "palette": "Cool",
  "phrases": {
    "Intro": {
      "routine": "idle-orbit",
      "visuals": {
        "scene": "wash",
        "params": {
          "color": "@secondary",
          "pulse": 0.3
        }
      }
    },
    "Verse": {
      "routine": "verse-sweep",
      "visuals": {
        "scene": "bars",
        "params": {
          "color": "@primary",
          "count": 8
        }
      }
    },
    "Up": {
      "routine": "build-rise",
      "visuals": {
        "scene": "particles",
        "params": {
          "color": "@accent",
          "burst": 1
        }
      }
    },
    "Chorus": {
      "routine": "fan-drop",
      "variation": "wide",
      "palette": "Hot",
      "visuals": {
        "scene": "tunnel",
        "params": {
          "color": "@primary",
          "speed": 2
        }
      }
    },
    "Down": {
      "routine": "idle-orbit",
      "params": {
        "color": "@secondary"
      },
      "visuals": {
        "scene": "wash",
        "params": {
          "color": "@secondary",
          "pulse": 0.6
        }
      }
    },
    "Bridge": {
      "routine": "verse-sweep",
      "variation": "wide",
      "visuals": {
        "scene": "bars",
        "params": {
          "color": "@secondary",
          "count": 16
        }
      }
    },
    "Outro": {
      "routine": "idle-orbit",
      "visuals": {
        "scene": "wash",
        "params": {
          "color": "@secondary",
          "pulse": 0.3
        }
      }
    },
    "*": {
      "routine": "verse-sweep",
      "visuals": {
        "scene": "wash",
        "params": {
          "color": "@primary",
          "pulse": 0.4
        }
      }
    }
  },
  "bars": {
    "every": 16,
    "cycle": [
      {
        "routine": "verse-sweep"
      },
      {
        "routine": "fan-drop",
        "palette": "Hot"
      }
    ]
  },
  "transition": {
    "fade_beats": 2
  }
}
