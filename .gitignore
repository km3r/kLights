# QLC+ source checkout (installed system-wide, ~146M) — not part of the show
qlcplus/

# Generated render output
renders/

# Python cache
__pycache__/
*.pyc

# Large / bulky 3D + capture assets (regenerable, not show-critical source)
*.blend
*.blend1
*.ply
*.glb
model.obj
model2.obj
checkerboard.obj

# Vendor PDF manual
bar_usermanual.pdf

# Workspace auto-backups — git history is the real history now
events/*/backups/
*.bak

# Unreal generated trees. The .uproject, Config/ and Content/Python/ are source;
# everything else the editor writes is derived from them and is gigabytes of it.
previz/unreal/Binaries/
previz/unreal/Build/
previz/unreal/DerivedDataCache/
previz/unreal/Intermediate/
previz/unreal/Saved/
previz/unreal/.vs/
*.sln

# The previz level and its materials are rebuilt in full by build_level.py from
# venue.json/rig.json/calibration.json, so they are output, not source — and
# they are binary, so tracking them would churn a .umap and six .uasset files on
# every rebuild. A fresh clone opens to an empty level; run build_level.py.
# Hand-made assets, if there are ever any, do NOT belong under these two paths.
previz/unreal/Content/Maps/
previz/unreal/Content/Previz/

# UI build inputs. node_modules is reinstallable; ui/dist is NOT ignored --
# it is committed on purpose so a show laptop needs only Python and a checkout,
# with no Node toolchain at the venue. Rebuild with `cd ui && npm run build`.
ui/node_modules/
ui/tsconfig.tsbuildinfo
